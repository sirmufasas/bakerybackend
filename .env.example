# Core Backend Configuration (Render)
PORT=3000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/mydatabase
JWT_SECRET=<strong-random-secret>
RESEND_API_KEY=<your_resend_api_key>
FRONTEND_URL=https://portubakery.netlify.app

# Yoco Online Payment Gateway (ZAR Settlement to Linked Capitec Bank Account)
# Copy from Yoco Business Portal -> Selling Online -> Payment Gateway -> API Keys
YOCO_SECRET_KEY=<your_yoco_secret_key>
YOCO_PUBLIC_KEY=<your_yoco_public_key>
# Optional: Webhook signing secret from Yoco Portal for POST /api/payments/webhook/yoco
YOCO_WEBHOOK_SECRET=<your_yoco_webhook_secret>
